# Google Ads CLI Configuration
# Copy to .env and fill in your values

# Required: Google Ads developer token
GADS_DEVELOPER_TOKEN=

# Required: OAuth2 credentials
GADS_CLIENT_ID=
GADS_CLIENT_SECRET=
GADS_REFRESH_TOKEN=

# Required: Customer ID (without hyphens)
GADS_CUSTOMER_ID=

# Optional: Login customer ID for MCC accounts
GADS_LOGIN_CUSTOMER_ID=

# Optional: Direct access token (overrides OAuth flow)
GADS_ACCESS_TOKEN=

# Optional: Service account authentication
GADS_SERVICE_ACCOUNT_KEY=
GADS_SERVICE_ACCOUNT_SUBJECT=

# Optional: Config directory (default: ~/.config/gadscli)
GADS_CONFIG_DIR=
